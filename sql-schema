-- DPI READINESS INDEX — SCHEMA + VIEWS + SCORING RUBRIC
-- Kenya / Rwanda / Tanzania Digital Public Infrastructure Readiness
--
-- Run this file first to create the database, tables, views, and the
-- 12-indicator scoring rubric.
--
-- Usage:   mysql -u root -p < 01_schema.sql
-- Or:      paste into MySQL Workbench / DBeaver and run all.
-- ════════════════════════════════════════════════════════════════════════

CREATE DATABASE IF NOT EXISTS dpi_readiness_index
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE dpi_readiness_index;

-- ── TABLES ──────────────────────────────────────────────────────────────

-- scoring_rubric: defines each of the 12 sub-indicators (3 per dimension x
-- 4 dimensions), their weights, scoring bands, and how transferable each
-- indicator is across country contexts (high / conditional / low).
CREATE TABLE IF NOT EXISTS scoring_rubric (
    si_code            VARCHAR(10)  PRIMARY KEY,
    si_name            VARCHAR(100) NOT NULL,
    dimension          VARCHAR(100) NOT NULL,
    dimension_weight   DOUBLE       NOT NULL,
    si_weight          DOUBLE       NOT NULL,
    rubric_10          TEXT,
    rubric_5           TEXT,
    rubric_2           TEXT,
    ambition_rubric_10 TEXT,
    ambition_rubric_5  TEXT,
    transferability    VARCHAR(20)  CHECK (transferability IN ('high', 'conditional', 'low')),
    transfer_reasoning TEXT
);

-- raw_indicators: the underlying sourced data point for each
-- country x sub-indicator x year, with full source attribution.
CREATE TABLE IF NOT EXISTS raw_indicators (
    id           INT          PRIMARY KEY AUTO_INCREMENT,
    country      VARCHAR(20)  NOT NULL CHECK (country IN ('Kenya', 'Rwanda', 'Tanzania')),
    dimension    VARCHAR(100) NOT NULL,
    si_code      VARCHAR(10)  NOT NULL,
    si_name      VARCHAR(100) NOT NULL,
    raw_value    DOUBLE,
    unit         VARCHAR(100),
    data_type    VARCHAR(20)  CHECK (data_type IN ('quantitative', 'qualitative')),
    year         INT,
    source       VARCHAR(255),
    source_url   VARCHAR(500),
    data_quality VARCHAR(20)  CHECK (data_quality IN ('hard', 'estimated', 'qualitative')),
    CONSTRAINT uq_country_indicator_year UNIQUE (country, si_code, year),
    FOREIGN KEY (si_code) REFERENCES scoring_rubric(si_code)
);

-- computed_scores: the analyst-assigned capability/ambition scores (1-10)
-- derived by applying the scoring_rubric bands to each raw_indicators row.
CREATE TABLE IF NOT EXISTS computed_scores (
    id               INT         PRIMARY KEY AUTO_INCREMENT,
    country          VARCHAR(20) NOT NULL CHECK (country IN ('Kenya', 'Rwanda', 'Tanzania')),
    si_code          VARCHAR(10) NOT NULL,
    capability_score DOUBLE      CHECK (capability_score BETWEEN 1 AND 10),
    ambition_score   DOUBLE      CHECK (ambition_score BETWEEN 1 AND 10),
    CONSTRAINT uq_country_si UNIQUE (country, si_code),
    FOREIGN KEY (si_code) REFERENCES scoring_rubric(si_code)
);

-- ── VIEWS ───────────────────────────────────────────────────────────────

-- alignment_gaps: per-indicator gap between stated ambition and actual
-- capability, plus each score's contribution to the composite index.
DROP VIEW IF EXISTS alignment_gaps;
CREATE VIEW alignment_gaps AS
SELECT
    cs.country,
    cs.si_code,
    sr.si_name,
    sr.dimension,
    sr.transferability,
    cs.capability_score,
    cs.ambition_score,
    ROUND(cs.ambition_score - cs.capability_score, 1) AS alignment_gap,
    ROUND(cs.capability_score * sr.si_weight, 3)      AS weighted_capability
FROM computed_scores cs
JOIN scoring_rubric sr ON cs.si_code = sr.si_code
ORDER BY cs.country, sr.dimension, cs.si_code;

-- dimension_summary: capability, ambition, and alignment gap averaged
-- (and weight-adjusted) at the dimension level (D1-D4) per country.
DROP VIEW IF EXISTS dimension_summary;
CREATE VIEW dimension_summary AS
SELECT
    cs.country,
    sr.dimension,
    ROUND(AVG(cs.capability_score), 2)                                     AS avg_capability,
    ROUND(AVG(cs.ambition_score), 2)                                       AS avg_ambition,
    ROUND(AVG(cs.ambition_score - cs.capability_score), 2)                 AS avg_alignment_gap,
    ROUND(SUM(cs.capability_score * sr.si_weight) / SUM(sr.si_weight), 2)  AS weighted_capability
FROM computed_scores cs
JOIN scoring_rubric sr ON cs.si_code = sr.si_code
GROUP BY cs.country, sr.dimension
ORDER BY cs.country, sr.dimension;

-- composite_index: single weighted composite capability/ambition/gap
-- score per country, ranked highest-capability first. This is the
-- headline output of the whole model.
DROP VIEW IF EXISTS composite_index;
CREATE VIEW composite_index AS
SELECT
    cs.country,
    ROUND(SUM(cs.capability_score * sr.si_weight), 2)                       AS composite_capability,
    ROUND(SUM(cs.ambition_score   * sr.si_weight), 2)                       AS composite_ambition,
    ROUND(SUM((cs.ambition_score - cs.capability_score) * sr.si_weight), 2) AS composite_alignment_gap
FROM computed_scores cs
JOIN scoring_rubric sr ON cs.si_code = sr.si_code
GROUP BY cs.country
ORDER BY composite_capability DESC;

-- transferability_summary: how many sub-indicators fall into each
-- transferability tier (high / conditional / low) — used to assess how
-- much of Rwanda's/Kenya's DPI approach could realistically transfer
-- to Tanzania.
DROP VIEW IF EXISTS transferability_summary;
CREATE VIEW transferability_summary AS
SELECT
    transferability,
    COUNT(*)                                              AS indicator_count,
    GROUP_CONCAT(si_code ORDER BY si_code SEPARATOR ', ')  AS sub_indicators
FROM scoring_rubric
GROUP BY transferability;

